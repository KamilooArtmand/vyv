{
  "name": "vyv-player",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:store": "npm run build && electron-builder --win appx",
    "release:win": "npm run build && electron-builder --win nsis --publish always",
    "catalog": "node scripts/snapshot-catalog.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "main": "electron/main.cjs",
  "description": "vyv \u2014 KRD PLY national multimedia player (web + desktop)",
  "build": {
    "appId": "io.krd.vyv",
    "productName": "vyv",
    "copyright": "\u00a9 KRD",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "KamilooArtmand",
        "repo": "vyv",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "vyv-Setup-${version}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "publisherName": [
          "KRD"
        ]
      },
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "vyv",
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "identityName": "KRD.vyv",
      "publisher": "CN=REPLACE-WITH-PARTNER-CENTER-PUBLISHER-ID",
      "publisherDisplayName": "KRD",
      "displayName": "vyv",
      "backgroundColor": "#07080A",
      "languages": [
        "en-US",
        "fa-IR",
        "ckb-IQ"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  },
  "author": "KRD",
  "repository": {
    "type": "git",
    "url": "https://github.com/KamilooArtmand/vyv.git"
  }
}
