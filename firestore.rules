rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY INCIDENT FIX (2026-09-27): a prior commit left this database
    // world-readable AND world-writable ("allow read, write: if true" on
    // every document). That is now closed. Nothing in this app requires a
    // public Firestore database — deny everything by default until (and
    // unless) a real backend need justifies specific, narrow rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
