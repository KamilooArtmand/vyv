@page "/"
@inject IWindowService WindowService
@inject vyv_player_desktop.Services.IAudioService AudioService
@inject vyv_player_desktop.Services.LibraryService LibraryService
@inject vyv_player_desktop.Services.ArtworkService ArtworkService
@inject vyv_player_desktop.Services.AIAgentService AIAgentService
@inject vyv_player_desktop.Services.NativeMediaService NativeMediaService
@inject vyv_player_desktop.Services.FolderPickerService FolderPickerService
@inject vyv_player_desktop.Services.LyricsService LyricsService
@inject vyv_player_desktop.Services.RadioService RadioService
@inject vyv_player_desktop.Services.AuthService AuthService
@inject vyv_player_desktop.Services.NotificationService NotificationService

<div class="app-container" style="background-image: radial-gradient(circle at 20% 30%, @(CurrentDominantColor) 0%, transparent 50%), radial-gradient(circle at 80% 70%, #18181b 0%, transparent 50%);">
    
    @if (IsAuthPanelOpen)
    {
        <vyv_player_desktop.Components.Player.AuthPanel OnClose="() => IsAuthPanelOpen = false" />
    }

    @if (CurrentMode == PlayerMode.Full)
    {
        <div class="full-player">
            <div class="full-sidebar">
                <div style="display:flex; flex-wrap:wrap; justify-content:space-around; margin-bottom:15px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:10px; gap:10px;">
                    <span class="clickable-text" style="font-size:0.8rem; font-weight: @(CurrentTab == "Archive" ? "bold" : "normal"); color: @(CurrentTab == "Archive" ? "#fff" : "#a1a1aa")" @onclick='() => ChangeTab("Archive")'>آرشیو</span>
                    <span class="clickable-text" style="font-size:0.8rem; font-weight: @(CurrentTab == "Radio" ? "bold" : "normal"); color: @(CurrentTab == "Radio" ? "#fff" : "#a1a1aa")" @onclick='() => ChangeTab("Radio")'>رادیو</span>
                    <span class="clickable-text" style="font-size:0.8rem; font-weight: @(CurrentTab == "Favorites" ? "bold" : "normal"); color: @(CurrentTab == "Favorites" ? "#fff" : "#a1a1aa")" @onclick='() => ChangeTab("Favorites")'>علاقه‌مندی</span>
                    <span class="clickable-text" style="font-size:0.8rem; font-weight: @(CurrentTab == "History" ? "bold" : "normal"); color: @(CurrentTab == "History" ? "#fff" : "#a1a1aa")" @onclick='() => ChangeTab("History")'>سابقه</span>
                </div>
                
                @if (CurrentTab == "Archive")
                {
                    <button class="btn" style="width:100%; border-radius:10px; margin-bottom:15px; height: 40px;" @onclick="ScanMusicFolder" disabled="@IsScanning">@(IsScanning ? "در حال اسکن..." : "افزودن پوشه Music")</button>
                }
                else
                {
                    <p style="font-size:0.8rem; color:#a1a1aa; text-align:center;">پخش زنده از اینترنت</p>
                }
                
                <hr style="border:0; border-top: 1px solid rgba(255,255,255,0.1); margin: 20px 0;" />
                <p class="artist clickable-text" @onclick="() => SetMode(PlayerMode.Cover)">[تغییر به Cover]</p>
                <p class="artist clickable-text" @onclick="() => SetMode(PlayerMode.Micro)">[تغییر به Micro]</p>
                <p class="artist clickable-text" @onclick="() => SetMode(PlayerMode.Nano)">[تغییر به Nano]</p>
                
                <hr style="border:0; border-top: 1px solid rgba(255,255,255,0.1); margin: 20px 0;" />
                <p class="artist clickable-text" @onclick="() => ShowSettings = !ShowSettings">تنظیمات پیشرفته ⚙️</p>
                @if (ShowSettings)
                {
                    <label style="font-size:0.8rem; color:#a1a1aa; margin-top:10px; display:block;">خروجی صدا:</label>
                    <select @onchange="OnDeviceChanged" style="width: 100%; padding: 8px; border-radius: 8px; background: rgba(0,0,0,0.2); color: inherit; border: 1px solid rgba(255,255,255,0.1); margin-top:5px; margin-bottom:15px;">
                        <option value="-1">خروجی پیش‌فرض سیستم</option>
                        @foreach (var device in AudioDevices)
                        {
                            <option value="@device.id" selected="@(device.id == SelectedDeviceId)">@device.name</option>
                        }
                    </select>

                    <label style="font-size:0.8rem; color:#a1a1aa; display:block;">اکولایزر (DSP):</label>
                    <div style="background: rgba(0,0,0,0.2); padding: 10px; border-radius: 8px; margin-top:5px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:0.7rem;">Bass</span>
                            <input type="range" min="-15" max="15" step="1" @bind="EQLow" @bind:event="oninput" @onchange="UpdateEQ" style="width:70%;" />
                        </div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:5px;">
                            <span style="font-size:0.7rem;">Mid</span>
                            <input type="range" min="-15" max="15" step="1" @bind="EQMid" @bind:event="oninput" @onchange="UpdateEQ" style="width:70%;" />
                        </div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:5px;">
                            <span style="font-size:0.7rem;">Treble</span>
                            <input type="range" min="-15" max="15" step="1" @bind="EQHigh" @bind:event="oninput" @onchange="UpdateEQ" style="width:70%;" />
                        </div>
                    </div>
                }
            </div>
            <div class="full-main">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div>
                        <h2 class="title" style="font-size: 2rem;">کشف موسیقی</h2>
                        <p class="artist" style="font-size: 1rem;">(Liquid Glass UI)</p>
                    </div>
                    <div style="flex: 0.7; margin-right: 30px; position: relative;">
                        <input type="text" @bind="AiCommandText" @bind:event="oninput" @onkeyup="HandleAiCommand" placeholder="به دستیار بگو: آهنگ‌های شاد رو پلی کن..." 
                            style="width: 100%; padding: 12px 20px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.05); color: inherit; font-family: inherit; font-size: 0.9rem; outline: none; backdrop-filter: blur(10px);" />
                        <svg style="position: absolute; left: 15px; top: 12px; opacity: 0.5;" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                        
                        @if (!string.IsNullOrEmpty(AiMessage))
                        {
                            <div style="position: absolute; right: 0; top: 50px; background: rgba(0,0,0,0.8); color: white; padding: 5px 15px; border-radius: 10px; font-size: 0.8rem; z-index: 100;">
                                @AiMessage
                            </div>
                        }
                    </div>
                    
                    <div style="display: flex; align-items: center;">
                        <div style="margin-right: 20px; cursor: pointer; position: relative;" @onclick="CheckNotifications">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <!-- Notification Badge -->
                            <div style="position: absolute; top: -3px; right: -2px; width: 10px; height: 10px; background: #ff4444; border-radius: 50%; border: 2px solid #18181b;"></div>
                        </div>

                        <div style="margin-right: 20px; cursor: pointer;" @onclick="() => IsAuthPanelOpen = true">
                        @if (AuthService.CurrentUser != null)
                        {
                            <img src="@AuthService.CurrentUser.AvatarUrl" style="width: 45px; height: 45px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.2);" />
                        }
                        else
                        {
                            <div style="width: 45px; height: 45px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); display: flex; justify-content: center; align-items: center; color: white;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                            </div>
                        }
                        </div>
                    </div>
                </div>
                <div style="flex:1; overflow-y:auto; margin-top:20px;">
                    @if (CurrentTab == "Archive" && (Tracks == null || Tracks.Count == 0))
                    {
                        <p class="artist">هنوز آهنگی اضافه نشده است. پوشه خود را اسکن کنید.</p>
                    }
                    else if (CurrentTab == "Radio" && (RadioStations == null || RadioStations.Count == 0))
                    {
                        <p class="artist">در حال بارگذاری لیست رادیوها...</p>
                    }
                    else
                    {
                        <table style="width: 100%; text-align: right; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 1px solid rgba(0,0,0,0.1); opacity:0.6;">
                                    <th style="padding:10px;">عنوان</th>
                                    <th>هنرمند</th>
                                    <th>آلبوم</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var track in GetDisplayTracks())
                                {
                                    <tr style="border-bottom: 1px solid rgba(0,0,0,0.05); cursor:pointer; background: @(CurrentTrack?.Id == track.Id ? "rgba(0,0,0,0.1)" : "transparent")" @onclick="() => PlayTrack(track)">
                                        <td style="padding:10px;">@track.Title</td>
                                        <td>
                                            @track.Artist 
                                            @if (CurrentTab == "Radio") { <span style="font-size: 0.7rem; background: red; color: white; border-radius: 4px; padding: 2px 4px; margin-right: 5px;">LIVE</span> }
                                        </td>
                                        <td>@track.Album</td>
                                        <td @onclick:stopPropagation="true">
                                            @if (CurrentTab != "Radio")
                                            {
                                                <svg @onclick="() => ToggleFavorite(track)" width="20" height="20" viewBox="0 0 24 24" fill="@(track.IsFavorite ? "#ff4444" : "none")" stroke="@(track.IsFavorite ? "#ff4444" : "currentColor")" stroke-width="2" style="cursor:pointer; vertical-align:middle; transition: 0.2s;">
                                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                                </svg>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
            <div class="glass full-player-bar">
                <div class="micro-cover" style="width: 40px; height: 40px; border-radius: 8px; background-image: url('@(CurrentCoverUrl)');"></div>
                <div style="margin-left: 15px; flex: 1; display: flex; align-items: center;">
                    <div>
                        <h2 class="title">@(CurrentTrack?.Title ?? "بدون پخش")</h2>
                        <p class="artist">@(CurrentTrack?.Artist ?? "-")</p>
                    </div>
                    
                    @if (CurrentTrack != null && CurrentTab != "Radio")
                    {
                        <div style="margin-left: 15px;">
                            <svg @onclick="() => ToggleFavorite(CurrentTrack)" width="20" height="20" viewBox="0 0 24 24" fill="@(CurrentTrack.IsFavorite ? "#ff4444" : "none")" stroke="@(CurrentTrack.IsFavorite ? "#ff4444" : "currentColor")" stroke-width="2" style="cursor:pointer; vertical-align:middle; transition: 0.2s;">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </div>
                    }

                    @if (IsPlaying)
                    {
                        <div style="display: flex; align-items: flex-end; height: 30px; margin-left: 30px; gap: 3px;">
                            @foreach (var band in FftBands)
                            {
                                <div style="width: 4px; background-color: @CurrentDominantColor; border-radius: 2px; height: @(Math.Max(4, band * 150))px; transition: height 0.05s ease;"></div>
                            }
                        </div>
                    }
                </div>
                <div class="micro-controls" style="direction: ltr; align-items:center;">
                    <div class="btn" @onclick="PlayPrevTrack">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
                    </div>
                    <div class="btn" style="transform: scale(1.2);" @onclick="TogglePlayPause">
                        @if (IsPlaying)
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        }
                    </div>
                    <div class="btn" @onclick="PlayNextTrack">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (CurrentMode == PlayerMode.Cover)
    {
        <div class="cover-player" @onclick="() => SetMode(PlayerMode.Full)" style="cursor:pointer; background-image: url('@(CurrentCoverUrl)');">
            <div class="overlay">
                @if (CurrentLyrics != null && CurrentLyrics.Count > 0 && CurrentLyricIndex >= 0)
                {
                    <h2 class="title" style="font-size: 1.8rem; text-shadow: 0 2px 10px rgba(0,0,0,0.8); color: #fff; text-align: center;">@CurrentLyrics[CurrentLyricIndex].Text</h2>
                }
                else
                {
                    <h2 class="title" style="font-size: 1.5rem;">@(CurrentTrack?.Title ?? "vyv Player")</h2>
                    <p class="artist">@(CurrentTrack?.Artist ?? "No audio playing")</p>
                }
            </div>
        </div>
    }
    else if (CurrentMode == PlayerMode.Micro)
    {
        <div class="micro-player" @ondblclick="() => SetMode(PlayerMode.Full)">
            <div class="micro-cover" style="background-image: url('@(CurrentCoverUrl)');"></div>
            <div class="micro-info" style="direction: ltr; flex: 1; display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <h2 class="title">@(CurrentTrack?.Title ?? "vyv Player")</h2>
                    <p class="artist">@(CurrentTrack?.Artist ?? "No audio")</p>
                </div>
                @if (IsPlaying)
                {
                    <div style="display: flex; align-items: flex-end; height: 20px; gap: 2px;">
                        @foreach (var band in FftBands.Take(10))
                        {
                            <div style="width: 3px; background-color: @CurrentDominantColor; border-radius: 1px; height: @(Math.Max(3, band * 100))px; transition: height 0.05s ease;"></div>
                        }
                    </div>
                }
            </div>
            <div class="micro-controls" style="direction: ltr; align-items:center;">
                <div class="btn" @onclick="PlayPrevTrack">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
                </div>
                <div class="btn" style="transform: scale(1.2);" @onclick="TogglePlayPause">
                    @if (IsPlaying)
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    }
                </div>
                <div class="btn" @onclick="PlayNextTrack">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
                </div>
            </div>
        </div>
    }
    else if (CurrentMode == PlayerMode.Nano)
    {
        <div class="nano-player" @ondblclick="() => SetMode(PlayerMode.Full)" style="background-image: url('@(CurrentCoverUrl)');">
            <div class="glass-overlay" style="direction: ltr;">
                <span style="color: white; cursor:pointer;" @onclick="TogglePlayPause">
                    @if (IsPlaying)
                    {
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    }
                    else
                    {
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    }
                </span>
            </div>
        </div>
    }
</div>

@code {
    public enum PlayerMode { Full, Cover, Micro, Nano }
    public PlayerMode CurrentMode { get; set; } = PlayerMode.Full;
    
    private List<vyv_player_desktop.Models.Track> Tracks = new();
    private List<vyv_player_desktop.Models.Track> RadioStations = new();
    private vyv_player_desktop.Models.Track? CurrentTrack;
    private bool IsPlaying = false;
    private System.Timers.Timer? _timer;

    private bool ShowSettings = false;
    private bool IsAuthPanelOpen = false;
    private string CurrentTab = "Archive"; // Archive or Radio
    private List<(int id, string name)> AudioDevices = new();
    private int SelectedDeviceId = -1;
    
    private double EQLow = 0;
    private double EQMid = 0;
    private double EQHigh = 0;

    private void UpdateEQ()
    {
        AudioService.SetEqualizer(EQLow, EQMid, EQHigh);
    }

    private void ChangeTab(string tab)
    {
        CurrentTab = tab;
        StateHasChanged();
    }

    private IEnumerable<vyv_player_desktop.Models.Track> GetDisplayTracks()
    {
        return CurrentTab switch
        {
            "Archive" => Tracks,
            "Radio" => RadioStations,
            "Favorites" => LibraryService.GetFavorites(),
            "History" => LibraryService.GetHistory(),
            _ => Tracks
        };
    }

    private void ToggleFavorite(vyv_player_desktop.Models.Track track)
    {
        LibraryService.ToggleFavorite(track.Id);
        track.IsFavorite = !track.IsFavorite; // Update local state
        StateHasChanged();
    }

    private void CheckNotifications()
    {
        NotificationService.CheckForNewsAndUpdates();
    }

    protected override void OnInitialized()
    {
        AudioService.Initialize();
        Tracks = LibraryService.GetAllTracks();
        RadioStations = RadioService.GetRadioStations();
        AudioDevices = AudioService.GetAudioDevices();
        
        AuthService.OnAuthStateChanged += () => InvokeAsync(StateHasChanged);
        
        AudioService.OnPlaybackEnded += () => {
            InvokeAsync(() => {
                PlayNextTrack();
            });
        };

        // Auto check for newsletter updates after 5 seconds of launch
        _ = Task.Run(async () => {
            await Task.Delay(5000);
            InvokeAsync(() => {
                CheckNotifications();
            });
        });

        NativeMediaService.RegisterCallbacks(
            onPlay: () => InvokeAsync(() => { AudioService.Resume(); IsPlaying = true; NativeMediaService.UpdateState(true); StateHasChanged(); }),
            onPause: () => InvokeAsync(() => { AudioService.Pause(); IsPlaying = false; NativeMediaService.UpdateState(false); StateHasChanged(); }),
            onNext: () => InvokeAsync(() => PlayNextTrack()),
            onPrev: () => InvokeAsync(() => PlayPrevTrack())
        );

        _timer = new System.Timers.Timer(50);
        _timer.Elapsed += (s, e) => {
            InvokeAsync(() => {
                IsPlaying = AudioService.IsPlaying;
                
                if (IsPlaying)
                {
                    FftBands = AudioService.GetFFT();
                    
                    if (CurrentLyrics != null && CurrentLyrics.Count > 0)
                    {
                        var spanPos = TimeSpan.FromSeconds(AudioService.GetPosition());
                        int newIndex = CurrentLyrics.FindLastIndex(l => l.Time <= spanPos);
                        if (newIndex != CurrentLyricIndex)
                        {
                            CurrentLyricIndex = newIndex;
                        }
                    }
                }
                
                StateHasChanged();
            });
        };
        _timer.Start();
    }

    private void SetMode(PlayerMode mode)
    {
        CurrentMode = mode;
        WindowService.SetMode(mode.ToString());
        StateHasChanged();
    }

    private bool IsScanning = false;

    private async Task ScanMusicFolder()
    {
        var path = await FolderPickerService.PickFolderAsync();
        if (string.IsNullOrEmpty(path)) return;

        IsScanning = true;
        StateHasChanged();

        await LibraryService.ScanFolderAsync(path);
        Tracks = LibraryService.GetAllTracks();
        
        IsScanning = false;
        StateHasChanged();
    }

    private string CurrentCoverUrl = "https://picsum.photos/400/400?grayscale";
    private string CurrentDominantColor = "#a1a1aa";
    
    private List<vyv_player_desktop.Services.LyricLine> CurrentLyrics = new();
    private int CurrentLyricIndex = -1;
    
    private float[] FftBands = new float[16];

    private void OnDeviceChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int deviceId))
        {
            SelectedDeviceId = deviceId;
            AudioService.SetAudioDevice(deviceId);
        }
    }

    private void PlayTrack(vyv_player_desktop.Models.Track track)
    {
        CurrentTrack = track;
        
        if (CurrentTab != "Radio")
        {
            LibraryService.AddToHistory(track.Id);
        }

        AudioService.Play(track.FilePath);
        IsPlaying = true;
        
        NativeMediaService.UpdateState(true);
        NativeMediaService.UpdateMetadata(track.Title, track.Artist);

        CurrentLyrics = LyricsService.ParseLrc(track.FilePath);
        CurrentLyricIndex = -1;

        // Extract artwork dynamically
        var artData = ArtworkService.GetArtwork(track.FilePath);
        if (!string.IsNullOrEmpty(artData.Base64Image))
        {
            CurrentCoverUrl = artData.Base64Image;
            CurrentDominantColor = artData.DominantColorHex;
        }
        else
        {
            CurrentCoverUrl = "https://picsum.photos/400/400?grayscale";
            CurrentDominantColor = "#a1a1aa";
        }
    }

    private void PlayNextTrack()
    {
        if (Tracks.Count == 0) return;
        if (CurrentTrack == null) { PlayTrack(Tracks[0]); return; }
        
        var idx = Tracks.IndexOf(CurrentTrack);
        if (idx < Tracks.Count - 1)
            PlayTrack(Tracks[idx + 1]);
        else
            PlayTrack(Tracks[0]); // Loop back to start
    }

    private void PlayPrevTrack()
    {
        if (Tracks.Count == 0) return;
        if (CurrentTrack == null) { PlayTrack(Tracks[0]); return; }
        
        var idx = Tracks.IndexOf(CurrentTrack);
        if (idx > 0)
            PlayTrack(Tracks[idx - 1]);
        else
            PlayTrack(Tracks[Tracks.Count - 1]);
    }

    private void TogglePlayPause()
    {
        if (CurrentTrack == null) return;
        
        if (AudioService.IsPlaying)
        {
            AudioService.Pause();
            IsPlaying = false;
            NativeMediaService.UpdateState(false);
        }
        else
        {
            AudioService.Resume();
            IsPlaying = true;
            NativeMediaService.UpdateState(true);
        }
    }

    private string AiCommandText = "";
    private string AiMessage = "";

    private void HandleAiCommand(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(AiCommandText))
        {
            var result = AIAgentService.ProcessCommand(AiCommandText);
            AiMessage = result.Message;
            
            if (result.Action == "Play")
            {
                if (result.TargetTrack != null)
                {
                    PlayTrack(result.TargetTrack);
                }
                else
                {
                    AudioService.Resume();
                    IsPlaying = true;
                }
            }
            else if (result.Action == "Pause")
            {
                AudioService.Pause();
                IsPlaying = false;
            }
            else if (result.Action == "Next")
            {
                PlayNextTrack();
            }
            else if (result.Action == "Search" && result.FilteredTracks != null)
            {
                Tracks = result.FilteredTracks;
            }
            
            AiCommandText = "";
            StateHasChanged();
            
            // Clear message after 3 seconds
            Task.Delay(3000).ContinueWith(_ => {
                AiMessage = "";
                InvokeAsync(StateHasChanged);
            });
        }
    }
}
