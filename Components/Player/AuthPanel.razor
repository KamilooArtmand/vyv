@inject vyv_player_desktop.Services.AuthService AuthService

<div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); backdrop-filter: blur(20px); z-index: 1000; display: flex; justify-content: center; align-items: center;" @onclick="ClosePanel">
    
    @if (AuthService.CurrentUser == null)
    {
        <div style="width: 400px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 40px; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.5);" @onclick:stopPropagation="true">
            <h2 style="color: white; margin-bottom: 30px; font-weight: 300;">ورود به حساب کاربری</h2>
            
            @if (IsLoading)
            {
                <div style="margin: 50px 0; color: #a1a1aa;">در حال احراز هویت... ⏳</div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 15px;">
                    <button class="btn" style="background: white; color: black;" @onclick='() => LoginOAuth("Google")'>ورود با گوگل</button>
                    <button class="btn" style="background: #1877F2; color: white;" @onclick='() => LoginOAuth("Facebook")'>ورود با فیسبوک</button>
                    
                    <div style="margin: 10px 0; color: #a1a1aa; font-size: 0.9rem;">یـا</div>
                    
                    <input type="email" @bind="Email" placeholder="ایمیل" style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; outline: none;" />
                    <input type="password" @bind="Password" placeholder="رمز عبور" style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; outline: none;" />
                    
                    <button class="btn" @onclick="LoginEmail">ورود با ایمیل</button>
                    <button class="btn" style="background: transparent; border: 1px solid rgba(255,255,255,0.2);" @onclick="RegisterEmail">ثبت نام جدید</button>
                    
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div style="color: #ff4444; font-size: 0.8rem; margin-top: 10px;">@ErrorMessage</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div style="width: 450px; background: #18181b; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.5);" @onclick:stopPropagation="true">
            <!-- Cover Photo -->
            <div style="height: 150px; background-image: url('@AuthService.CurrentUser.CoverUrl'); background-size: cover; background-position: center; position: relative;">
                <div style="position: absolute; top: 15px; right: 15px;">
                    <button class="btn" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); padding: 5px 15px; font-size: 0.8rem;" @onclick="ToggleEditMode">
                        @(IsEditing ? "لغو ویرایش" : "ویرایش پروفایل ✏️")
                    </button>
                </div>
            </div>
            
            <div style="padding: 0 30px 30px 30px; text-align: center; position: relative;">
                <!-- Avatar -->
                <img src="@AuthService.CurrentUser.AvatarUrl" style="width: 100px; height: 100px; border-radius: 50%; border: 4px solid #18181b; margin-top: -50px; margin-bottom: 15px; background: #27272a; object-fit: cover;" />
                
                @if (IsEditing)
                {
                    <div style="display: flex; flex-direction: column; gap: 10px; text-align: right;">
                        <input type="text" @bind="EditUsername" placeholder="نام نمایشی" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; outline: none;" />
                        <input type="text" @bind="EditHandle" placeholder="شناسه کاربری (@@Handle)" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; outline: none;" />
                        <textarea @bind="EditBio" placeholder="بیوگرافی..." style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; outline: none; resize: none;" rows="2"></textarea>
                        
                        <label style="font-size: 0.8rem; color: #a1a1aa; margin-top: 5px;">لینک عکس پروفایل:</label>
                        <input type="text" @bind="EditAvatarUrl" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; outline: none;" />
                        
                        <label style="font-size: 0.8rem; color: #a1a1aa; margin-top: 5px;">لینک عکس کاور:</label>
                        <input type="text" @bind="EditCoverUrl" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; outline: none;" />
                        
                        <button class="btn" style="margin-top: 15px;" @onclick="SaveChanges">ذخیره تغییرات ✔️</button>
                    </div>
                }
                else
                {
                    <h2 style="color: white; margin-bottom: 2px; font-size: 1.5rem;">@AuthService.CurrentUser.Username</h2>
                    <p style="color: #ff4444; margin-bottom: 10px; font-size: 0.9rem;">@AuthService.CurrentUser.Handle</p>
                    <p style="color: #a1a1aa; font-size: 0.9rem; margin-bottom: 20px;">@AuthService.CurrentUser.Bio</p>
                    
                    <div style="background: rgba(255,255,255,0.05); border-radius: 15px; padding: 15px; margin-bottom: 20px; display: flex; justify-content: space-around; border: 1px solid rgba(255,255,255,0.05);">
                        <div>
                            <div style="font-size: 1.2rem; font-weight: bold; color: white;">@AuthService.CurrentUser.FollowersCount</div>
                            <div style="color: #a1a1aa; font-size: 0.75rem;">دنبال‌کننده‌ها</div>
                        </div>
                        <div>
                            <div style="font-size: 1.2rem; font-weight: bold; color: white;">@AuthService.CurrentUser.FollowingCount</div>
                            <div style="color: #a1a1aa; font-size: 0.75rem;">دنبال‌شوندگان</div>
                        </div>
                        <div>
                            <div style="font-size: 1.2rem; font-weight: bold; color: white;">PRO</div>
                            <div style="color: #a1a1aa; font-size: 0.75rem;">وضعیت</div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px;">
                        <button class="btn" style="flex: 1; background: #fff; color: #000;" @onclick="ToggleFollow">
                            @(IsFollowing ? "دنبال می‌کنید" : "دنبال کردن +")
                        </button>
                        <button class="btn" style="background: rgba(255,68,68,0.2); color: #ff4444; border: 1px solid rgba(255,68,68,0.5);" @onclick="Logout">خروج</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string Email = "";
    private string Password = "";
    private bool IsLoading = false;
    private string ErrorMessage = "";
    
    // Edit Profile State
    private bool IsEditing = false;
    private string EditUsername = "";
    private string EditHandle = "";
    private string EditBio = "";
    private string EditAvatarUrl = "";
    private string EditCoverUrl = "";
    
    // Mock Social State
    private bool IsFollowing = false;

    private void ToggleFollow()
    {
        if (AuthService.CurrentUser == null) return;
        IsFollowing = !IsFollowing;
        if (IsFollowing) AuthService.CurrentUser.FollowersCount++;
        else AuthService.CurrentUser.FollowersCount--;
    }

    private void ToggleEditMode()
    {
        IsEditing = !IsEditing;
        if (IsEditing && AuthService.CurrentUser != null)
        {
            EditUsername = AuthService.CurrentUser.Username;
            EditHandle = AuthService.CurrentUser.Handle;
            EditBio = AuthService.CurrentUser.Bio;
            EditAvatarUrl = AuthService.CurrentUser.AvatarUrl;
            EditCoverUrl = AuthService.CurrentUser.CoverUrl;
        }
    }

    private async Task SaveChanges()
    {
        await AuthService.UpdateUserProfileAsync(EditUsername, EditHandle, EditBio, EditAvatarUrl, EditCoverUrl);
        IsEditing = false;
    }

    private async Task ClosePanel()
    {
        if (IsEditing) return; // Prevent closing by clicking outside while editing
        await OnClose.InvokeAsync();
    }

    // Auth Methods
    private async Task LoginOAuth(string provider)
    {
        IsLoading = true;
        ErrorMessage = "";
        StateHasChanged();
        await AuthService.LoginWithOAuthAsync(provider);
        IsLoading = false;
    }

    private async Task LoginEmail()
    {
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Password)) return;
        IsLoading = true;
        ErrorMessage = "";
        StateHasChanged();
        bool success = await AuthService.LoginWithEmailAsync(Email, Password);
        if (!success) ErrorMessage = "ایمیل یا رمز عبور اشتباه است.";
        IsLoading = false;
    }

    private async Task RegisterEmail()
    {
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Password)) return;
        IsLoading = true;
        ErrorMessage = "";
        StateHasChanged();
        bool success = await AuthService.RegisterWithEmailAsync(Email.Split('@')[0], Email, Password);
        if (!success) ErrorMessage = "این ایمیل قبلاً ثبت شده است.";
        IsLoading = false;
    }

    private void Logout()
    {
        AuthService.Logout();
    }
}
