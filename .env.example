# vyv — environment (copy to .env; never commit real values)

# Sign-in: vyv has no usernames or passwords, only Google and Facebook.
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorised JavaScript origins: http://localhost:3000 and your production origin.
VITE_GOOGLE_CLIENT_ID=
# Optional, desktop app only: an OAuth client of type "Desktop app" (loopback + PKCE).
# Falls back to VITE_GOOGLE_CLIENT_ID. Its non-confidential secret goes in the
# shell environment as VYV_GOOGLE_CLIENT_SECRET (read by electron/main.cjs, not bundled).
VITE_GOOGLE_DESKTOP_CLIENT_ID=

# Meta for Developers → App → Facebook Login. Add your site URL under
# "Valid OAuth Redirect URIs"; for desktop also allow
# https://www.facebook.com/connect/login_success.html
VITE_FACEBOOK_APP_ID=

# Optional: YouTube Data API v3 key (restrict it to your origins). Enables video search.
VITE_YOUTUBE_API_KEY=
