# vyv — environment (copy to .env.local; never commit real values)
# Full walkthrough in Persian: docs/GUIDE-fa.md

# ── Accounts + database (recommended): Supabase ─────────────
# Supabase → Project Settings → API. The anon key is public by design;
# Row Level Security in supabase/migrations keeps every user's data private.
# With these set, Google/Facebook are configured in the Supabase dashboard
# (Authentication → Providers) and the VITE_GOOGLE_/VITE_FACEBOOK_ ids below are not needed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Without Supabase: direct sign-in, library stays on the device ──
# Google Cloud Console → Credentials → OAuth client ID (Web application).
VITE_GOOGLE_CLIENT_ID=
# Desktop app: an OAuth client of type "Desktop app" (loopback + PKCE).
VITE_GOOGLE_DESKTOP_CLIENT_ID=
# Meta for Developers → App → Facebook Login.
VITE_FACEBOOK_APP_ID=

# ── Optional ────────────────────────────────────────────────
# YouTube Data API v3 key (restrict to your origins). Enables YouTube video search.
VITE_YOUTUBE_API_KEY=
